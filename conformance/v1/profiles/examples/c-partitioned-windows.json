{
	"$schema": "../../../../schema/v1/profile.schema.json",
	"schemaVersion": "1.0",
	"id": "example-partitioned-windows",
	"kind": "hardware",
	"device": { "brand": "Example", "model": "Partitioned windows" },
	"match": { "bluetooth": [{ "namePrefix": "Example Ear" }] },
	"bandCount": 4,
	"band": {
		"types": ["PK"],
		"q": { "min": 0.5, "max": 3, "step": 0.1 },
		"gain": { "min": -6, "max": 6, "step": 0.5 }
	},
	"bands": [
		{ "index": 0, "types": ["LSC", "PK"], "freq": { "min": 20, "max": 200 } },
		{ "index": 1, "freq": { "min": 200, "max": 1000 } },
		{ "index": 2, "freq": { "min": 1000, "max": 4000 } },
		{ "index": 3, "types": ["PK", "HSC"], "freq": { "min": 4000, "max": 20000 } }
	],
	"rules": [{ "type": "ascendingFrequency" }],
	"preamp": { "mode": "auto" },
	"meta": {
		"status": "draft",
		"sources": [{ "kind": "community", "ref": "SPEC §12 example C", "date": "2026-10-02" }],
		"notes": "SPEC §12 example C: frequency-partitioned slots (Nothing-style; values illustrative)."
	}
}

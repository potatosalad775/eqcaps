{
	"$schema": "../../../schema/v1/profile.schema.json",
	"schemaVersion": "1.0",
	"id": "base",
	"kind": "hardware",
	"device": { "brand": "Example", "model": "Base" },
	"match": { "usb": [{ "vendorId": "0x0001", "productId": "0x0001" }] },
	"bandCount": 4,
	"band": {
		"types": ["PK"],
		"freq": { "min": 20, "max": 20000 },
		"q": { "min": 0.1, "max": 10, "step": 0.01 },
		"gain": { "min": -12, "max": 12, "step": 0.1 }
	},
	"preamp": { "mode": "none" },
	"meta": {
		"status": "draft",
		"sources": [{ "kind": "community", "ref": "conformance base profile", "date": "2026-10-02" }]
	}
}

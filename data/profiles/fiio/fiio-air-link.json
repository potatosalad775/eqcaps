{
	"$schema": "../../../schema/v1/source.schema.json",
	"extends": "fiio-peq-10-band-12db-wide-all-filters",
	"id": "fiio-air-link",
	"device": { "brand": "FiiO", "model": "Air Link" },
	"match": { "usb": [{ "vendorId": ["0x0a12", "0x2972"], "productName": "FIIO Air Link" }] },
	"protocol": {
		"presets": [
			{ "id": 0, "name": "Jazz" },
			{ "id": 1, "name": "Pop" },
			{ "id": 2, "name": "Rock" },
			{ "id": 3, "name": "Dance" },
			{ "id": 5, "name": "R&B" },
			{ "id": 6, "name": "Classic" },
			{ "id": 7, "name": "Hip-hop" },
			{ "id": 4, "name": "USER1" },
			{ "id": 8, "name": "USER2" },
			{ "id": 9, "name": "USER3" },
			{ "id": 11, "name": "Close EQ", "bypass": true }
		]
	},
	"meta": {
		"status": "draft",
		"sources": [
			{
				"kind": "handler-code",
				"ref": "https://github.com/jeromeof/devicePEQ/blob/0617f382e76629792a5933e6933e4b396a756a93/devicePEQ/usbDeviceConfig.js",
				"date": "2026-10-02"
			}
		],
		"notes": "devicePEQ gives only the id of the preset that turns the EQ off; its name, \"Close EQ\", is assumed from other FiiO models."
	}
}

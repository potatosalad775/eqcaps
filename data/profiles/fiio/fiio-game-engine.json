{
	"$schema": "../../../schema/v1/source.schema.json",
	"extends": "fiio-usb-hid",
	"id": "fiio-game-engine",
	"schemaVersion": "1.1",
	"device": { "brand": "FiiO", "model": "Game Engine" },
	"match": { "usb": [{ "vendorId": ["0x0a12", "0x2972"], "productName": "FIIO GAME ENGINE" }] },
	"bandCount": 10,
	"band": {
		"types": ["PK", "LSC", "HSC", "LPQ", "HPQ", "BP"],
		"gain": { "min": -24, "max": 12, "step": 0.1 }
	},
	"preamp": { "mode": "manual", "gain": { "min": -24, "max": 12, "step": 0.1 } },
	"protocol": {
		"presets": [
			{ "id": 13, "name": "HiFi" },
			{ "id": 257, "name": "FPS" },
			{ "id": 258, "name": "ACT" },
			{ "id": 259, "name": "MOBA" },
			{ "id": 260, "name": "MUG" },
			{ "id": 513, "name": "Cinema" },
			{ "id": 160, "name": "USER1", "writable": true },
			{ "id": 161, "name": "USER2", "writable": true },
			{ "id": 162, "name": "USER3", "writable": true }
		]
	},
	"meta": {
		"status": "draft",
		"sources": [
			{ "kind": "vendor-app", "ref": "https://fiiocontrol.fiio.com/", "date": "2026-11-03" }
		],
		"notes": "FiiO Control asks the device for its band count; 10 is the app's default layout, not a confirmed count for this model."
	}
}
